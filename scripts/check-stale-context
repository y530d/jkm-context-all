#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   ./scripts/check-stale-context [path ...]
# Optional:
#   STALE_CONTEXT_DAYS=120 ./scripts/check-stale-context
# Defaults:
#   Scans context/, goals/, projects/, and knowledge/.
#   Excludes templates/, sources/, outputs/, and archive/ unless passed explicitly.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 - "$repo_root" "$@" <<'PY'
from __future__ import annotations

import datetime as dt
import os
import pathlib
import re
import sys

repo_root = pathlib.Path(sys.argv[1])
today = dt.date.today()
threshold_days = int(os.environ.get("STALE_CONTEXT_DAYS", "90"))
pattern = re.compile(r"^last_verified:\s*(\d{4}-\d{2}-\d{2})\s*$", re.MULTILINE)
raw_targets = sys.argv[2:] or ["context", "goals", "projects", "knowledge"]
targets = [repo_root / target for target in raw_targets]

issues: list[str] = []
seen_paths: set[pathlib.Path] = set()
duplicate_paths: set[pathlib.Path] = set()
for target in targets:
    if target.is_file() and target.suffix == ".md":
        if target in seen_paths:
            duplicate_paths.add(target)
        seen_paths.add(target)
    elif target.is_dir():
        for path in target.rglob("*.md"):
            if path in seen_paths:
                duplicate_paths.add(path)
            seen_paths.add(path)

if duplicate_paths:
    print("Note: duplicate Markdown targets were collapsed:", file=sys.stderr)
    for path in sorted(duplicate_paths):
        print(f"- {path.relative_to(repo_root)}", file=sys.stderr)

for path in sorted(seen_paths):
    text = path.read_text(encoding="utf-8")
    match = pattern.search(text)
    rel = path.relative_to(repo_root)
    if not match:
        issues.append(f"MISSING  {rel}")
        continue
    verified = dt.date.fromisoformat(match.group(1))
    age_days = (today - verified).days
    if age_days < 0:
        issues.append(f"FUTURE   {rel} ({verified.isoformat()})")
        continue
    if age_days > threshold_days:
        issues.append(f"STALE    {rel} ({age_days} days old)")

if issues:
    print("Stale-context review found issues:")
    for issue in issues:
        print(issue)
    sys.exit(1)

print(f"All checked Markdown files have a last_verified date within {threshold_days} days.")
PY
